---
// Every page of the site, in every language: the home, the articles, the
// sections and "About". The main language is at the root, the others
// under /<language>/; the words in the addresses come from site.config.mjs.
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import ArticlePage from '../components/ArticlePage.astro';
import About from '../components/About.astro';
import Numbers from '../components/Numbers.astro';
import {
  BASE, LANGS, MAIN, SITE, absolute, alternates, articleUrl, articles, asset, href, paths, sectionLabel, sectionOf, sectionSlug, slugOf,
  sectionIntro, t, tagline, type Article, type Lang, type Section,
} from '../lib/site';

type Page =
  | { kind: 'home'; lang: Lang; list: Article[]; demo: boolean }
  | { kind: 'article'; lang: Lang; article: Article; related: Article[] }
  | { kind: 'section'; lang: Lang; section: Section; list: Article[]; demo: boolean }
  | { kind: 'about'; lang: Lang }
  | { kind: 'numbers'; lang: Lang };

export async function getStaticPaths() {
  const out: { params: { path: string | undefined }; props: Page }[] = [];
  const at = (lang: Lang, ...parts: string[]) => {
    const p = [lang === MAIN ? '' : lang, ...parts].filter(Boolean).join('/');
    return p || undefined;
  };
  for (const lang of LANGS) {
    const { list, demo } = await articles(lang);
    const p = paths(lang);
    out.push({ params: { path: at(lang) }, props: { kind: 'home', lang, list, demo } });
    out.push({ params: { path: at(lang, p.about) }, props: { kind: 'about', lang } });
    out.push({ params: { path: at(lang, p.numbers) }, props: { kind: 'numbers', lang } });
    for (const section of SITE.sections) {
      const inSection = list.filter((a) => sectionOf(a) === section);
      out.push({ params: { path: at(lang, p.section, sectionSlug(section, lang)) },
                 props: { kind: 'section', lang, section, list: inSection, demo: demo && inSection.length > 0 } });
    }
    for (const article of list) {
      const section = sectionOf(article);
      const near = list.filter((a) => a !== article && section && sectionOf(a) === section);
      const related = [...near, ...list.filter((a) => a !== article && !near.includes(a))].slice(0, 3);
      out.push({ params: { path: at(lang, p.article, slugOf(article)) }, props: { kind: 'article', lang, article, related } });
    }
  }
  return out;
}

const page = Astro.props as Page;
// The first articles of a list, in order, as schema.org reads them.
const itemList = (list: Article[]) => ({ '@type': 'ItemList', itemListElement: list.slice(0, 20).map((a, i) => (
  { '@type': 'ListItem', position: i + 1, url: absolute(articleUrl(a)), name: a.data.title })) });
const lang = page.lang;
const s = t(lang);
let title: string | undefined;
let description: string | undefined;
let jsonld: object | undefined;
let others: Partial<Record<Lang, string>> = {};
if (page.kind === 'article') {
  others = await alternates(page.article);
  const a = page.article.data;
  title = a.title;
  description = a.description;
  const section = sectionOf(page.article);
  jsonld = {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: a.title,
    description: a.description,
    datePublished: a.date.toISOString(),
    dateModified: a.date.toISOString(),
    isAccessibleForFree: true,
    inLanguage: lang,
    mainEntityOfPage: absolute(articleUrl(page.article)),
    image: a.image ? [absolute(asset(a.image)!)] : undefined,
    articleSection: section ? sectionLabel(section, lang) : undefined,
    keywords: a.keywords?.join(', '),
    author: SITE.ai === 'automatic'
      ? { '@type': 'Organization', name: `${SITE.name} AI newsroom`, url: absolute(href(lang, paths(lang).about)) }
      : { '@type': 'Organization', name: a.author || SITE.name, url: absolute(href(lang)) },
    publisher: { '@type': 'Organization', name: SITE.publisher.name || SITE.name, url: SITE.publisher.url || SITE.url },
    isPartOf: { '@id': `${absolute(href(lang))}#website` },
  };
} else if (page.kind === 'section') {
  title = sectionLabel(page.section, lang);
  description = sectionIntro(page.section, lang) || [`${title} · ${SITE.name}`, tagline(lang)].filter(Boolean).join(': ');
  jsonld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description,
             url: absolute(href(lang, paths(lang).section, sectionSlug(page.section, lang))), inLanguage: lang,
             isPartOf: { '@id': `${absolute(href(lang))}#website` }, mainEntity: itemList(page.list) };
} else if (page.kind === 'about') {
  title = s.about;
} else if (page.kind === 'numbers') {
  title = s.numbersTitle;
  description = s.numbersLead;
} else {
  // The site, who publishes it and its latest articles: what search engines
  // and AI assistants read to know the site and its news.
  description = tagline(lang) || undefined;
  jsonld = { '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', '@id': `${absolute(href(lang))}#website`, name: SITE.name, url: absolute(href(lang)),
      description, inLanguage: lang, publisher: { '@id': `${absolute(href(MAIN))}#publisher` } },
    { '@type': 'NewsMediaOrganization', '@id': `${absolute(href(MAIN))}#publisher`, name: SITE.name,
      url: absolute(href(MAIN)), logo: absolute(`${BASE}/favicon.svg`),
      publishingPrinciples: absolute(href(lang, paths(lang).about)),
      parentOrganization: SITE.publisher.name
        ? { '@type': 'Organization', name: SITE.publisher.name, url: SITE.publisher.url || undefined } : undefined },
    { '@type': 'CollectionPage', name: SITE.name, url: absolute(href(lang)), inLanguage: lang,
      isPartOf: { '@id': `${absolute(href(lang))}#website` }, mainEntity: itemList(page.list) },
  ] };
}
---
<Layout lang={lang} title={title} description={description} image={page.kind === 'article' ? page.article.data.image : undefined}
        type={page.kind === 'article' ? 'article' : 'website'} jsonld={jsonld} alternates={others}>
  {page.kind === 'home' && <><h1 class="sr-only">{SITE.name}</h1><Home list={page.list} lang={lang} bySection demo={page.demo} /></>}
  {page.kind === 'section' && <Home list={page.list} lang={lang} title={title} intro={sectionIntro(page.section, lang)}
                                    emptyText={s.emptySection} demo={page.demo} />}
  {page.kind === 'article' && <ArticlePage article={page.article} related={page.related} />}
  {page.kind === 'about' && <About lang={lang} />}
  {page.kind === 'numbers' && <Numbers lang={lang} />}
</Layout>
